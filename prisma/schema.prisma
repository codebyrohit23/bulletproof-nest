// ======================================================
// Prisma Configuration
// ======================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// Enums
// ======================================================

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

enum IdentifierType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum VerificationCodeStatus {
  ACTIVE
  CONSUMED
  SUPERSEDED
  BLOCKED
  EXPIRED
}

enum PasswordResetTokenStatus {
  ACTIVE
  CONSUMED
  SUPERSEDED
  EXPIRED
}

enum UserAuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum SessionRevokeReason {
  LOGOUT
  USER_REVOKED
  ADMIN_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  TOKEN_REUSE_DETECTED
  SUPERSEDED
}

enum TokenRevokeReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  SESSION_REVOKED
}

enum DeviceType {
  DESKTOP
  LAPTOP
  TABLET
  MOBILE
  OTHER
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

enum InvitationStatus {
  CREATED
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RoleSource {
  SYSTEM
  CUSTOM
}

// ======================================================
// User Model
// ======================================================

model User {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  firstName String @map("first_name") @db.VarChar(100)

  lastName String? @map("last_name") @db.VarChar(100)

  displayName String @map("display_name") @db.VarChar(150)

  avatarFileId String? @map("avatar_file_id") @db.Uuid

  status UserStatus @default(ACTIVE)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  identities UserIdentity[] @relation("UserIdentities")

  credential UserCredential? @relation("UserCredential")

  authAccounts UserAuthAccount[] @relation("UserAuthAccounts")

  sessions UserSession[] @relation("UserSessions")

  pushTokens UserPushToken[] @relation("UserPushTokens")

  passwordResetTokens UserPasswordResetToken[] @relation("UserPasswordResetTokens")

  // memberships WorkspaceMember[] @relation("UserMemberships")

  // invitationsSent WorkspaceInvitation[] @relation("UserSentInvitations")

  @@index([status])
  @@map("users")
}

// ======================================================
// User Identity Model
// ======================================================

model UserIdentity {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserIdentities", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  identifierType IdentifierType @map("identifier_type")

  identifierValue String @map("identifier_value") @db.VarChar(320)

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, identifierType])
  @@unique([identifierValue, identifierType])
  @@map("user_identities")
}

// ======================================================
// User Credential Model
// ======================================================

model UserCredential {
  userId String @id @map("user_id") @db.Uuid

  user User @relation("UserCredential", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  passwordHash String @map("password_hash") @db.VarChar(255)

  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_credentials")
}

// ======================================================
// User Auth Account Model
// ======================================================

model UserAuthAccount {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserAuthAccounts", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  provider UserAuthProvider

  providerAccountId String @map("provider_account_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("user_auth_accounts")
}

// ======================================================
// User Session Model
// ======================================================
model UserSession {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  deviceId String? @map("device_id") @db.VarChar(255)

  deviceName String? @map("device_name") @db.VarChar(255)

  deviceType DeviceType? @map("device_type")

  platform DevicePlatform? @map("platform")

  browserName String? @map("browser_name") @db.VarChar(100)

  browserVersion String? @map("browser_version") @db.VarChar(50)

  osName String? @map("os_name") @db.VarChar(100)

  osVersion String? @map("os_version") @db.VarChar(100)

  userAgent String? @map("user_agent") @db.Text

  ipAddress String? @map("ip_address") @db.Inet

  countryCode String? @map("country_code") @db.Char(2)

  region String? @map("region") @db.VarChar(100)

  city String? @map("city") @db.VarChar(100)

  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  revokedReason SessionRevokeReason? @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  refreshTokens UserRefreshToken[] @relation("UserRefreshTokens")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ======================================================
// User Refresh Token Model
// ======================================================
model UserRefreshToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  sessionId String @map("session_id") @db.Uuid

  session UserSession @relation("UserRefreshTokens", fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  revokedReason TokenRevokeReason? @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ======================================================
// Verification Code Model
// ======================================================
model VerificationCode {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  identifierType IdentifierType @map("identifier_type")

  identifierValue String @map("identifier_value") @db.VarChar(320)

  purpose VerificationPurpose

  codeHash String? @map("code_hash") @db.VarChar(64)

  attempts Int @default(0)

  status VerificationCodeStatus @default(ACTIVE)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifierValue, identifierType, purpose, createdAt(sort: Desc)], map: "verification_codes_lookup_idx")
  @@map("verification_codes")
}

// ======================================================
// User Password Reset Token Model
// ======================================================
model UserPasswordResetToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  status PasswordResetTokenStatus @default(ACTIVE)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("user_password_reset_tokens")
}

// ======================================================
// User Push Token Model
// ======================================================
model UserPushToken {
  userId String @map("user_id") @db.Uuid

  user User @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  deviceId String @map("device_id") @db.VarChar(255)

  token String @unique @db.Text

  platform DevicePlatform

  enabled Boolean @default(true)

  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([userId, deviceId])
  @@map("user_push_tokens")
}
