// ======================================================
// Admin Verification Code Model
// ======================================================
/// A one-time code proving control of an admin's mailbox.
///
/// Keyed by the admin, because the admin row is the identity: an admin has one
/// address and it lives on `admins`. Separate from `user_verification_codes`
/// so a code issued for a user can never answer an admin flow — the table, not
/// a filter, is the separation.
///
/// Only `PASSWORD_RESET` and `LOGIN` are issued here; `AdminCodePurpose` in
/// `modules/admin-auth` narrows the shared enum at compile time.
///
/// Defined in the migration, not expressible here:
///   admin_verification_codes_active_key
///     UNIQUE (admin_id, purpose) WHERE status = 'ACTIVE'
model AdminVerificationCode {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  adminId String @map("admin_id") @db.Uuid

  admin Admin @relation("AdminToAdminVerificationCode", fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  purpose VerificationPurpose

  codeHash String? @map("code_hash") @db.VarChar(64)

  attempts Int @default(0)

  status VerificationCodeStatus @default(ACTIVE)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminId, purpose, createdAt(sort: Desc)], map: "admin_verification_codes_lookup_idx")
  @@map("admin_verification_codes")
}

// ======================================================
// Outbox Message Model
// ======================================================

/// Intent to enqueue a job, written in the same transaction as the change that
/// caused it. Short-lived: `payload` is cleared on dispatch, rows removed after a day.
///
/// Defined in the migration, not expressible here:
///   outbox_messages_pending_idx   (available_at) WHERE status = 'PENDING'
///   outbox_messages_cleanup_idx   (created_at)   WHERE status <> 'PENDING'
///   chk_outbox_messages_dispatched        status <> 'DISPATCHED' OR dispatched_at IS NOT NULL
///   chk_outbox_messages_pending_payload   status <> 'PENDING' OR payload IS NOT NULL
///   autovacuum_vacuum_scale_factor = 0.01 (high-churn table)
model OutboxMessage {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  queue String @db.VarChar(64)

  jobName String @map("job_name") @db.VarChar(100)

  payload Json? @db.JsonB

  options Json? @db.JsonB

  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(200)

  status OutboxStatus @default(PENDING)

  attempts Int @default(0)

  lastError String? @map("last_error") @db.VarChar(1000)

  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)

  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)

  @@map("outbox_messages")
}

// ======================================================
// Outbound Message Model
// ======================================================

/// Every email and SMS the platform sends. Never stores the body — an OTP lives in it.
///
/// Defined in the migration, not expressible here:
///   outbound_messages_recipient_user_id_created_at_idx
///     (recipient_user_id, created_at DESC) WHERE recipient_user_id IS NOT NULL
///   outbound_messages_recipient_admin_id_created_at_idx
///     (recipient_admin_id, created_at DESC) WHERE recipient_admin_id IS NOT NULL
///   outbound_messages_problems_idx
///     (created_at DESC) WHERE status IN ('FAILED', 'BOUNCED', 'COMPLAINED')
///   chk_outbound_messages_single_recipient
///     recipient_user_id IS NULL OR recipient_admin_id IS NULL
model OutboundMessage {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  channel MessageChannel

  category MessageCategory

  templateKey String @map("template_key") @db.VarChar(100)

  recipient String @db.VarChar(320)

  recipientUserId String? @map("recipient_user_id") @db.Uuid

  recipientUser User? @relation("UserToOutboundMessage", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  recipientAdminId String? @map("recipient_admin_id") @db.Uuid

  recipientAdmin Admin? @relation("AdminToOutboundMessage", fields: [recipientAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  status MessageStatus @default(QUEUED)

  provider String? @db.VarChar(32)

  providerMessageId String? @map("provider_message_id") @db.VarChar(255)

  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(200)

  subject String? @db.VarChar(998)

  attempts Int @default(0)

  errorCode String? @map("error_code") @db.VarChar(100)

  errorMessage String? @map("error_message") @db.VarChar(1000)

  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  failedAt DateTime? @map("failed_at") @db.Timestamptz(6)

  @@unique([provider, providerMessageId])
  @@index([createdAt(sort: Desc)])
  @@index([recipient, createdAt(sort: Desc)])
  @@map("outbound_messages")
}
