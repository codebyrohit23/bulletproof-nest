// ======================================================
// Prisma Configuration
// ======================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// Enums
// ======================================================

enum UserState {
  PENDING
  ACTIVE
  SUSPENDED
}

enum IdentifierType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

enum UserAuthProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE
  FACEBOOK
}

enum SessionStatus {
  ACTIVE
  LOGGED_OUT
  REVOKED
  EXPIRED
}

enum TokenRevokeReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  SESSION_REVOKED
}

enum DeviceType {
  DESKTOP
  LAPTOP
  TABLET
  MOBILE
  OTHER
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum WorkspaceState {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

enum InvitationStatus {
  CREATED
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RoleSource {
  SYSTEM
  CUSTOM
}

// ======================================================
// User Model
// ======================================================

model User {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  firstName String @map("first_name") @db.VarChar(100)

  lastName String? @map("last_name") @db.VarChar(100)

  displayName String @map("display_name") @db.VarChar(150)

  avatarFileId String? @map("avatar_file_id") @db.Uuid

  state UserState @default(PENDING)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  identities UserIdentity[] @relation("UserIdentities")

  credential UserCredential? @relation("UserCredential")

  authAccounts UserAuthAccount[] @relation("UserAuthAccounts")

  sessions UserSession[] @relation("UserSessions")

  // memberships WorkspaceMember[] @relation("UserMemberships")

  // invitationsSent WorkspaceInvitation[] @relation("UserSentInvitations")

  @@index([state])
  @@index([deletedAt])
  @@map("users")
}

// ======================================================
// User Identity Model
// ======================================================

model UserIdentity {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserIdentities", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  identifierType IdentifierType @map("identifier_type")

  identifierValue String @map("identifier_value") @db.VarChar(320)

  isVerified Boolean @default(false) @map("is_verified")

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, identifierType])
  @@unique([identifierType, identifierValue])
  @@index([identifierValue])
  @@index([isVerified])
  @@map("user_identities")
}

// ======================================================
// User Credential Model
// ======================================================

model UserCredential {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  user User @relation("UserCredential", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  passwordHash String @map("password_hash") @db.VarChar(255)

  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_credentials")
}

// ======================================================
// User Auth Account Model
// ======================================================

model UserAuthAccount {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserAuthAccounts", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  provider UserAuthProvider

  providerAccountId String @map("provider_account_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_auth_accounts")
}

// ======================================================
// User Session Model
// ======================================================

model UserSession {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status SessionStatus @default(ACTIVE)

  deviceId String? @map("device_id") @db.VarChar(255)

  deviceName String? @map("device_name") @db.VarChar(255)

  deviceType DeviceType? @map("device_type")

  platform DevicePlatform? @map("platform")

  browserName String? @map("browser_name") @db.VarChar(100)

  browserVersion String? @map("browser_version") @db.VarChar(50)

  osName String? @map("os_name") @db.VarChar(100)

  osVersion String? @map("os_version") @db.VarChar(100)

  userAgent String? @map("user_agent") @db.Text

  fcmToken String? @map("fcm_token") @db.Text

  pushEnabled Boolean @default(true) @map("push_enabled")

  ipAddress String? @map("ip_address") @db.Inet

  countryCode String? @map("country_code") @db.Char(2)

  countryName String? @map("country_name") @db.VarChar(100)

  region String? @map("region") @db.VarChar(100)

  city String? @map("city") @db.VarChar(100)

  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations

  refreshTokens UserRefreshToken[] @relation("UserRefreshTokens")

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("user_sessions")
}

// ======================================================
// User Refresh Token Model
// ======================================================

model UserRefreshToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  sessionId String @map("session_id") @db.Uuid

  session UserSession @relation("UserRefreshTokens", fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  revokedReason TokenRevokeReason? @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ======================================================
// User Refresh Token Model
// ======================================================

model VerificationCode {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  identifierType IdentifierType @map("identifier_type")

  identifierValue String @map("identifier_value") @db.VarChar(320)

  purpose VerificationPurpose

  codeHash String @map("code_hash") @db.VarChar(255)

  attempts Int @default(0)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifierType, identifierValue])
  @@index([expiresAt])
  @@index([purpose])
  @@map("verification_codes")
}
