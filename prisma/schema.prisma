// ======================================================
// Prisma Configuration
// ======================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// Enums
// ======================================================

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum IdentifierType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum VerificationCodeStatus {
  ACTIVE
  CONSUMED
  SUPERSEDED
  BLOCKED
  EXPIRED
}

enum PasswordResetTokenStatus {
  ACTIVE
  CONSUMED
  SUPERSEDED
  EXPIRED
}

enum UserAuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum SessionRevokeReason {
  LOGOUT
  USER_REVOKED
  ADMIN_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  TOKEN_REUSE_DETECTED
  SUPERSEDED
}

enum TokenRevokeReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  SESSION_REVOKED
}

enum DeviceType {
  DESKTOP
  LAPTOP
  TABLET
  MOBILE
  OTHER
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

enum InvitationStatus {
  CREATED
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RoleSource {
  SYSTEM
  CUSTOM
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  EXPIRED
  FAILED
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageCategory {
  TRANSACTIONAL
  MARKETING
}

/// Delivery state only, and it only moves forward. OPENED / CLICKED are events, not states.
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
  EXPIRED
}

// ======================================================
// User Model
// ======================================================

model User {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  firstName String @map("first_name") @db.VarChar(100)

  lastName String? @map("last_name") @db.VarChar(100)

  displayName String @map("display_name") @db.VarChar(150)

  avatarFileId String? @map("avatar_file_id") @db.Uuid

  status UserStatus @default(ACTIVE)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  identities UserIdentity[] @relation("UserToUserIdentity")

  credential UserCredential? @relation("UserToUserCredential")

  authAccounts UserAuthAccount[] @relation("UserToUserAuthAccount")

  sessions UserSession[] @relation("UserToUserSession")

  refreshTokens UserRefreshToken[] @relation("UserToUserRefreshToken")

  pushTokens UserPushToken[] @relation("UserToUserPushToken")

  passwordResetTokens UserPasswordResetToken[] @relation("UserToUserPasswordResetToken")

  outboundMessages OutboundMessage[] @relation("UserToOutboundMessage")

  // memberships WorkspaceMember[] @relation("UserToWorkspaceMember")

  // invitationsSent WorkspaceInvitation[] @relation("UserToWorkspaceInvitation_InvitedBy")

  @@index([status])
  @@map("users")
}

// ======================================================
// User Identity Model
// ======================================================
model UserIdentity {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserToUserIdentity", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  identifierType IdentifierType @map("identifier_type")

  identifierValue String @map("identifier_value") @db.VarChar(320)

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ======================================================
  // Relations
  // ======================================================

  verificationCodes UserVerificationCode[] @relation("UserIdentityToUserVerificationCode")

  @@unique([userId, identifierType])
  @@unique([identifierValue, identifierType])
  @@map("user_identities")
}

// ======================================================
// User Credential Model
// ======================================================
model UserCredential {
  userId String @id @map("user_id") @db.Uuid

  user User @relation("UserToUserCredential", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  passwordHash String @map("password_hash") @db.VarChar(255)

  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_credentials")
}

// ======================================================
// User Auth Account Model
// ======================================================
model UserAuthAccount {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserToUserAuthAccount", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  provider UserAuthProvider

  providerAccountId String @map("provider_account_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("user_auth_accounts")
}

// ======================================================
// User Session Model
// ======================================================
model UserSession {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserToUserSession", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  deviceId String? @map("device_id") @db.VarChar(255)

  deviceName String? @map("device_name") @db.VarChar(255)

  deviceType DeviceType? @map("device_type")

  platform DevicePlatform? @map("platform")

  browserName String? @map("browser_name") @db.VarChar(100)

  browserVersion String? @map("browser_version") @db.VarChar(50)

  osName String? @map("os_name") @db.VarChar(100)

  osVersion String? @map("os_version") @db.VarChar(100)

  userAgent String? @map("user_agent") @db.Text

  ipAddress String? @map("ip_address") @db.Inet

  countryCode String? @map("country_code") @db.Char(2)

  region String? @map("region") @db.VarChar(100)

  city String? @map("city") @db.VarChar(100)

  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  revokedReason SessionRevokeReason? @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  refreshTokens UserRefreshToken[] @relation("UserSessionToUserRefreshToken")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ======================================================
// User Refresh Token Model
// ======================================================
model UserRefreshToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserToUserRefreshToken", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  sessionId String @map("session_id") @db.Uuid

  session UserSession @relation("UserSessionToUserRefreshToken", fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  revokedReason TokenRevokeReason? @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("user_refresh_tokens")
}

// ======================================================
// User Password Reset Token Model
// ======================================================
model UserPasswordResetToken {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  user User @relation("UserToUserPasswordResetToken", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  status PasswordResetTokenStatus @default(ACTIVE)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("user_password_reset_tokens")
}

// ======================================================
// User Verification Code Model
// ======================================================
/// A one-time code proving control of one identity — this email, this phone.
///
/// Keyed by the identity, not the user: a user may hold an email and a phone,
/// and a code sent to one must not verify the other. Keyed by the row, not the
/// address string: every flow that issues a code has already found the identity
/// (registration creates it in the same transaction). Admin codes are a
/// separate table, so a code issued here can never answer an admin flow.
///
/// Defined in the migration, not expressible here:
///   user_verification_codes_active_key
///     UNIQUE (user_identity_id, purpose) WHERE status = 'ACTIVE'
model UserVerificationCode {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userIdentityId String @map("user_identity_id") @db.Uuid

  userIdentity UserIdentity @relation("UserIdentityToUserVerificationCode", fields: [userIdentityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  purpose VerificationPurpose

  codeHash String? @map("code_hash") @db.VarChar(64)

  attempts Int @default(0)

  status VerificationCodeStatus @default(ACTIVE)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userIdentityId, purpose, createdAt(sort: Desc)], map: "user_verification_codes_lookup_idx")
  @@map("user_verification_codes")
}

// ======================================================
// User Push Token Model
// ======================================================
model UserPushToken {
  userId String @map("user_id") @db.Uuid

  user User @relation("UserToUserPushToken", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  deviceId String @map("device_id") @db.VarChar(255)

  token String @unique @db.Text

  platform DevicePlatform

  enabled Boolean @default(true)

  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([userId, deviceId])
  @@map("user_push_tokens")
}

// ======================================================
// Admin
// ======================================================
model Admin {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  email String @db.VarChar(320)

  firstName String @map("first_name") @db.VarChar(100)

  lastName String? @map("last_name") @db.VarChar(100)

  displayName String @map("display_name") @db.VarChar(150)

  status AdminStatus @default(ACTIVE)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations

  credential AdminCredential? @relation("AdminToAdminCredential")

  sessions AdminSession[] @relation("AdminToAdminSession")

  refreshTokens AdminRefreshToken[] @relation("AdminToAdminRefreshToken")

  passwordResetTokens AdminPasswordResetToken[] @relation("AdminToAdminPasswordResetToken")

  verificationCodes AdminVerificationCode[] @relation("AdminToAdminVerificationCode")

  outboundMessages OutboundMessage[] @relation("AdminToOutboundMessage")

  @@index([status])
  @@map("admins")
}

// ======================================================
// Admin Credential
// ======================================================
model AdminCredential {
  adminId String @id @map("admin_id") @db.Uuid

  admin Admin @relation("AdminToAdminCredential", fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  passwordHash String @map("password_hash") @db.VarChar(255)

  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_credentials")
}

// ======================================================
// Admin Session
// ======================================================
model AdminSession {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  adminId String @map("admin_id") @db.Uuid

  admin Admin @relation("AdminToAdminSession", fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

