# This file was named `npmrc` (no leading dot) and was therefore never read by
# anything. Both settings below had never taken effect.

# Refuse to install when the running Node or pnpm falls outside the `engines`
# range in package.json, instead of warning and continuing.
engine-strict=true

# Install from the lockfile as-written rather than silently resolving newer
# versions. pnpm-only — `npx` will warn "Unknown project config
# 'prefer-frozen-lockfile'" because npm does not recognise it. That warning is
# expected and harmless: this project is pnpm-only, pinned via `packageManager`.
prefer-frozen-lockfile=true
