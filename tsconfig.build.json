{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "sourceMap": false,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },

  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],

  "exclude": ["node_modules", "dist", "test", "prisma.config.ts", "**/*.spec.ts", "**/*.test.ts"]
}
