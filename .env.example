# ==============================================================================
# leadflow-backend-service — environment contract
# ==============================================================================
#
# Copy to `.env` and fill in. Every variable here is validated at startup by
# `src/config/shared/schema.ts`; an invalid value fails the boot loudly rather
# than surfacing as a confusing error later.
#
#   cp .env.example .env
#   pnpm keys:generate          # then paste the two JWT_* lines it prints
#
# REQUIRED means the schema has no default — boot fails if it is absent.
# Everything else may be omitted, and the documented default applies.
#
# This file is committed. It must never contain a real secret.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application  (src/config/app/app.schema.ts)
# ------------------------------------------------------------------------------
# REQUIRED — one of: development | test | production
NODE_ENV=development

# REQUIRED — non-empty
APP_NAME=leadflow-backend-service

# REQUIRED
HOST=0.0.0.0

# REQUIRED — positive integer
PORT=3000

# REQUIRED — one of: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Default: json — one of: json | pretty
#
# `json` is one object per line for a log aggregator. `pretty` is colourised
# output for a human terminal, and costs real throughput, so it is opt-in.
#
# Deliberately NOT derived from NODE_ENV: tailing a staging or production pod
# during an incident is exactly when readable output is worth most.
LOG_FORMAT=pretty

# Default: false
#
# Mounts the Scalar API reference at /docs and /docs/admin. This flag is the
# whole access control — an open admin reference publishes every route, payload
# shape and field name to anyone who guesses the URL.
#
# Deliberately NOT derived from NODE_ENV: staging usually wants docs and
# production usually does not, which the environment name cannot express.
# Defaults to false so that saying nothing gives the safe answer.
DOCS_ENABLED=true

# REQUIRED — milliseconds
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Database  (src/config/database/database.schema.ts)
# ------------------------------------------------------------------------------
# REQUIRED — must be a valid URL. Also used by the Prisma CLI (prisma.config.ts).
# Behind a pooler (PgBouncer / Supabase / RDS Proxy), the Prisma CLI needs the
# DIRECT non-pooled URL.
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadflow

# Default: false
POSTGRES_SSL=false

# Default: warn,error — comma-separated Prisma log levels
POSTGRES_LOG_LEVEL=warn,error

# Pool tuning — all optional, defaults in database.constants.ts
# POSTGRES_POOL_MAX=
# POSTGRES_POOL_IDLE_TIMEOUT_MS=
# POSTGRES_POOL_CONNECTION_TIMEOUT_MS=
# POSTGRES_SLOW_QUERY_THRESHOLD_MS=

# ------------------------------------------------------------------------------
# JWT  (src/config/jwt/jwt.schema.ts)
# ------------------------------------------------------------------------------
# REQUIRED — base64-encoded Ed25519 PEM. Generate with `pnpm keys:generate`.
# Never commit these. Never reuse a key between environments.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optional — set only during a key rotation, so tokens signed with the previous
# key still verify. Remove once the longest token lifetime has elapsed.
# JWT_PUBLIC_KEY_PREVIOUS=

# REQUIRED — must be a valid URL
JWT_ISSUER=https://leadflow.local

# ------------------------------------------------------------------------------
# Redis  (src/config/redis/redis.schema.ts)
# ------------------------------------------------------------------------------
# REQUIRED — must be a valid URL
REDIS_URL=redis://localhost:6379

# Default: false
REDIS_TLS=false

# Default: "" — a non-empty value gets a trailing ':' appended automatically.
# Must not contain { or }.
REDIS_KEY_PREFIX=leadflow

# Timeouts and reconnect policy — all optional, defaults in redis.constants.ts
# REDIS_CONNECT_TIMEOUT_MS=
# REDIS_COMMAND_TIMEOUT_MS=
# REDIS_MAX_RETRIES_PER_REQUEST=
# REDIS_RECONNECT_MAX_ATTEMPTS=
# REDIS_RECONNECT_BASE_DELAY_MS=
# REDIS_RECONNECT_MAX_DELAY_MS=

# ------------------------------------------------------------------------------
# Security  (src/config/security/security.schema.ts)
# ------------------------------------------------------------------------------
# REQUIRED — minimum 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# REQUIRED — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Default: true
CORS_ENABLED=true
CORS_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
CSRF_ENABLED=true
